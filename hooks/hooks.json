{
  "description": "Norbert observability hooks — sends Claude Code events to the local hook receiver.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/PreToolUse -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/PostToolUse -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/SubagentStop -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/Stop -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/SessionStart -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:3748/hooks/UserPromptSubmit -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
